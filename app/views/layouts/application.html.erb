<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Star Wars Explorer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Star Wars Explorer", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <div class="navbar-nav">
            <%= nav_link "Home", root_path %>
            <%= nav_link "People", people_path %>
            <%= nav_link "Planets", planets_path %>
            <%= nav_link "Species", species_index_path %>
            <%= nav_link "Starships", starships_path %>
            <%= nav_link "Vehicles", vehicles_path %>
            <%= nav_link "Search", search_path %>
            <%= nav_link "About", about_path %>
          </div>
        </div>
      </div>
    </nav>

    <main class="container flex-grow-1">
      <%= yield %>
    </main>

    <footer class="bg-dark text-light py-3 mt-5">
      <div class="container small">
        Data from <a class="link-light" href="https://swapi.dev">SWAPI, the Star Wars API</a> · Built with Ruby on Rails
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
