<% content_for :title, "Home | Star Wars Explorer" %>

<h1 class="mb-3">Star Wars Explorer</h1>
<p class="lead">Browse characters, planets, species, starships and vehicles from the Star Wars universe.</p>

<% if @counts.values.sum > 0 %>
  <div class="row">
    <% @counts.each do |label, count| %>
      <div class="col-md-4 col-lg mb-3">
        <div class="card text-center h-100">
          <div class="card-body">
            <h2 class="card-title"><%= count %></h2>
            <p class="card-text"><%= label %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-warning">
    No data has been loaded yet. Run <code>bin/rails db:seed</code> to import it.
  </div>
<% end %>
