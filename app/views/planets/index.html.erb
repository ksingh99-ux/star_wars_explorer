<% content_for :title, "Planets | Star Wars Explorer" %>
<h1 class="mb-3">Planets</h1>

<table class="table table-striped">
  <thead>
    <tr><th>Name</th><th>Climate</th><th>Terrain</th><th>Population</th><th>Residents</th></tr>
  </thead>
  <tbody>
    <% @planets.each do |planet| %>
      <tr>
        <td><%= link_to planet.name, planet %></td>
        <td><%= planet.climate %></td>
        <td><%= planet.terrain %></td>
        <td><%= planet.population %></td>
        <td><%= planet.people.size %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @planets %>
