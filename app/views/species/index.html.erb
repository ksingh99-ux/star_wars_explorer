<% content_for :title, "Species | Star Wars Explorer" %>
<h1 class="mb-3">Species</h1>

<table class="table table-striped">
  <thead>
    <tr><th>Name</th><th>Classification</th><th>Designation</th><th>Language</th><th>Members</th></tr>
  </thead>
  <tbody>
    <% @species_list.each do |species| %>
      <tr>
        <td><%= link_to species.name, species %></td>
        <td><%= species.classification %></td>
        <td><%= species.designation %></td>
        <td><%= species.language %></td>
        <td><%= species.people.size %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @species_list %>
