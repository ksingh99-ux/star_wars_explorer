<% content_for :title, "#{@species.name} | Star Wars Explorer" %>
<h1 class="mb-4"><%= @species.name %></h1>

<div class="row">
  <div class="col-md-6">
    <h2>Details</h2>
    <dl class="row">
      <dt class="col-sm-4">Classification</dt><dd class="col-sm-8"><%= @species.classification %></dd>
      <dt class="col-sm-4">Designation</dt><dd class="col-sm-8"><%= @species.designation %></dd>
      <dt class="col-sm-4">Language</dt><dd class="col-sm-8"><%= @species.language %></dd>
    </dl>
  </div>

  <div class="col-md-6">
    <h2>Members</h2>
    <% if @species.people.any? %>
      <ul class="list-group">
        <% @species.people.order(:name).each do |person| %>
          <li class="list-group-item"><%= link_to person.name, person %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-muted">No known members.</p>
    <% end %>
  </div>
</div>

<%= link_to "← All species", species_index_path, class: "btn btn-secondary mt-4" %>
